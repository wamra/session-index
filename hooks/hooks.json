{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/session-index\" ingest --stdin-hook --embed || true",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/session-index\" ingest --stdin-hook --embed || true",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/session-index\" ingest --stdin-hook --embed || true",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ]
  },
  "modules": [
    "./register.ts"
  ]
}
